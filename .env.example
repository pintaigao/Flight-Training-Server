# Copy this file to `.env.local` for local development
# or `.env.production` for production.

NODE_ENV=development

# Server
PORT=3000

# Auth mode: "session" (cookie) or "jwt" (Authorization: Bearer <token>)
AUTH_MODE=jwt

# JWT only (used when AUTH_MODE=jwt)
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
REFRESH_COOKIE_NAME=refreshToken

# Session/Redis only (used when AUTH_MODE=session)
SESSION_SECRET=replace-me
REDIS_URL=redis://localhost:6379

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-me
DB_NAME=flightdb
DB_SYNCHRONIZE=false

# ADS-B tracker microservice
ADSB_TRACKER_BASE_URL=http://localhost:5053
ADSB_TRACKER_SERVICE_TOKEN=
