# Backend env examples

# Auth mode: "session" (cookie) or "jwt" (Authorization: Bearer <token>)
AUTH_MODE=session

# JWT only (used when AUTH_MODE=jwt)
JWT_SECRET=dev-jwt-secret

# Session/Redis only (used when AUTH_MODE=session)
SESSION_SECRET=dev-session-secret
REDIS_URL=redis://localhost:6379

# Server
PORT=3000

# ADS-B tracker microservice
ADSB_TRACKER_BASE_URL=http://localhost:5053
ADSB_TRACKER_SERVICE_TOKEN=
